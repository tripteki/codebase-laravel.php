{
    "version": "1.2.0",

    "type": "project",

    "license": "proprietary",

    "require": {

        "php": "^8.1",
        "laravel/framework": "^10.3",
        "laravel/octane": "^2.5",
        "nwidart/laravel-modules": "^10.0",

        "tripteki/laravelphp-import-export": "^1.0",
        "tripteki/laravelphp-request-response-query": "^1.0",
        "spatie/laravel-data": "^4.11",
        "darkaonline/l5-swagger": "^8.6",
        "tymon/jwt-auth": "^2.1",
        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-activitylog": "^4.10",
        "wikimedia/composer-merge-plugin": "^2.1",

        "guzzlehttp/guzzle": "^7.10",
        "pusher/pusher-php-server": "^7.2"
    },

    "require-dev": {

        "phpunit/phpunit": "^10.5.60",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",

        "laravel/tinker": "^2.10",
        "nunomaduro/collision": "^7.12"
    },

    "autoload": {

        "psr-4": {

            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },

        "files": [

            "app/Helpers/UrlHelper.php"
        ]
    },

    "autoload-dev": {

        "psr-4": {

            "Tests\\": "tests/"
        }
    },

    "scripts": {

        "dev": [

            "Composer\\Config::disableProcessTimeout",
            "php artisan octane:start --watch"
        ],

        "build": [

            "@php artisan optimize"
        ],

        "test": [

            "./vendor/bin/phpunit --testsuite Feature"
        ],

        "post-autoload-dump": [

            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },

    "extra": {

        "laravel": {

            "dont-discover": []
        },

        "merge-plugin": {

            "include": [
                "src/*/composer.json"
            ]
        }
    },

    "config": { "preferred-install": "dist", "sort-packages": true, "optimize-autoloader": true, "allow-plugins": { "pestphp/pest-plugin": true, "php-http/discovery": true, "wikimedia/composer-merge-plugin": true } }, "minimum-stability": "stable", "prefer-stable": true
}
