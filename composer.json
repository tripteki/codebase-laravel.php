{
    "version": "1.2.0",

    "type": "project",

    "license": "proprietary",

    "require": {

        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.5",
        "nwidart/laravel-modules": "^13.0",

        "maatwebsite/excel": "^3.1.69",
        "spatie/laravel-query-builder": "^7.0",
        "spatie/laravel-data": "^4.11",
        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-activitylog": "^4.10",
        "darkaonline/l5-swagger": "^11.0",
        "tymon/jwt-auth": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.1",

        "guzzlehttp/guzzle": "^7.10",
        "laravel/reverb": "^1.10",
        "laravel-notification-channels/webpush": "^11.0"
    },

    "require-dev": {

        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },

    "autoload": {

        "psr-4": {

            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },

        "files": [

            "app/Helpers/UrlHelper.php",
            "app/Helpers/AppNameHelper.php",
            "app/Helpers/CopyrightHelper.php"
        ]
    },

    "autoload-dev": {

        "psr-4": {

            "Tests\\": "tests/"
        }
    },

    "scripts": {

        "dev": [

            "Composer\\Config::disableProcessTimeout",
            "php artisan octane:start --watch"
        ],

        "start": [

            "Composer\\Config::disableProcessTimeout",
            "php artisan octane:start --host=0.0.0.0 --port=8000"
        ],

        "build": [

            "@php artisan optimize"
        ],

        "pm2:start": [

            "pm2 start ecosystem.config.cjs"
        ],

        "pm2:stop": [

            "pm2 stop ecosystem.config.cjs"
        ],

        "test": [

            "./vendor/bin/phpunit --testsuite Feature"
        ],

        "lint": [

            "./vendor/bin/pint"
        ],

        "lint:check": [

            "./vendor/bin/pint --test"
        ],

        "post-autoload-dump": [

            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },

    "extra": {

        "laravel": {

            "dont-discover": []
        },

        "merge-plugin": {

            "include": [
                "src/*/composer.json"
            ]
        }
    },

    "config": {

        "platform": {

            "php": "8.3.13"
        },

        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {

            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}
